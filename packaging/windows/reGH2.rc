#include <winver.h>

1 ICON "reGH2.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,2,1,0
PRODUCTVERSION 0,2,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "reGH2 contributors"
      VALUE "FileDescription", "reGH2 launcher (Guitar Hero II native port)"
      VALUE "FileVersion", "0.2.1"
      VALUE "InternalName", "reGH2"
      VALUE "LegalCopyright", "MIT licence"
      VALUE "OriginalFilename", "reGH2.exe"
      VALUE "ProductName", "reGH2"
      VALUE "ProductVersion", "0.2.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
