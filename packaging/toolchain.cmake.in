# Hermetic toolchain of the AppImage: bundled clang 20 + lld, glibc 2.35 / libstdc++ 13 sysroot.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER   @APPDIR@/usr/toolchain/bin/clang)
set(CMAKE_CXX_COMPILER @APPDIR@/usr/toolchain/bin/clang++)
set(CMAKE_SYSROOT @APPDIR@/usr/sysroot)
set(CMAKE_AR @APPDIR@/usr/toolchain/bin/llvm-ar CACHE FILEPATH "")
set(CMAKE_RANLIB @APPDIR@/usr/toolchain/bin/llvm-ranlib CACHE FILEPATH "")
set(CMAKE_MAKE_PROGRAM @APPDIR@/usr/toolchain/bin/ninja CACHE FILEPATH "")
set(_gcc "@APPDIR@/usr/sysroot/usr/lib/gcc/x86_64-linux-gnu/13")
set(CMAKE_C_FLAGS_INIT   "--gcc-install-dir=${_gcc}")
set(CMAKE_CXX_FLAGS_INIT "--gcc-install-dir=${_gcc} -stdlib=libstdc++")
set(CMAKE_EXE_LINKER_FLAGS_INIT    "-fuse-ld=lld -L@APPDIR@/usr/sdk/linux-amd64/lib -Wl,-rpath-link,@APPDIR@/usr/sdk/linux-amd64/lib")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
