+/// Who decides where an allocation goes. GH2: gh2k::mem keeps the allocation registry of the five heaps that own address space (the three virtual ones, the two XEX ones and the
+/// physical parent heap); the page table of BaseHeap stays as the mirror that tracks commit state, protection and write watches. A heap the authority does not handle (the physical
+/// windows 0xA0000000.., which pin their parent's allocations) works as before.
+struct HeapDescriptor {
+  uint32_t base, size, page_size;
+  bool physical_parent;   // the 512 MB physical heap the windows allocate from
+};
+class HeapAuthority {
+ public:
+  virtual ~HeapAuthority() = default;
+  virtual bool Handles(const HeapDescriptor& heap) = 0;
+  // Picks the address of an allocation of `size` bytes (a page multiple) inside [low, high] (inclusive); false if it does not fit.
+  virtual bool AllocRange(const HeapDescriptor& heap, uint32_t low, uint32_t high, uint32_t size, uint32_t alignment, bool top_down, uint32_t* address) = 0;
+  // A reservation at a given address (false: the range is taken).
+  virtual bool AllocFixed(const HeapDescriptor& heap, uint32_t address, uint32_t size) = 0;
+  virtual void Release(const HeapDescriptor& heap, uint32_t address) = 0;
+};
+void SetHeapAuthority(HeapAuthority* authority);   // before Memory::Initialize
+
 enum SystemHeapFlag : uint32_t {
   kSystemHeapVirtual = 1 << 0,
   kSystemHeapPhysical = 1 << 1,
@@ -278,6 +297,8 @@
   rex::thread::global_critical_region global_critical_region_;
   std::recursive_mutex heap_mutex_;
   std::vector<PageEntry> page_table_;
+  HeapAuthority* authority_ = nullptr;   // non-null when the registered authority handles this heap
