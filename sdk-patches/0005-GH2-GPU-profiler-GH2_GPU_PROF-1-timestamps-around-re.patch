+  struct GpuProfMarkRecord {
+    uint32_t query;
+    uint8_t label;
+    bool begin;
+  };
+  struct GpuProfFrame {
+    std::vector<GpuProfMarkRecord> marks;
+    uint64_t submission = 0;
+    uint32_t slice = 0;
+  };
+  void GpuProfFrameOpen();
+  void GpuProfFrameClose();  // at swap
+  void GpuProfPoll();
+  bool gpu_prof_enabled_ = false;
+  VkQueryPool gpu_prof_pool_ = VK_NULL_HANDLE;
+  uint32_t gpu_prof_frame_counter_ = 0;
+  GpuProfFrame gpu_prof_current_;
+  std::deque<GpuProfFrame> gpu_prof_pending_;
+  double gpu_prof_sum_ms_[kGpuProfLabelCount] = {};
+  uint32_t gpu_prof_counts_[kGpuProfLabelCount] = {};
+  double gpu_prof_period_ns_ = 0.0;
