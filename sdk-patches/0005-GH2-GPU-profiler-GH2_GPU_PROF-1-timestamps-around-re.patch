+// ---- GH2 GPU profiler -----------------------------------------------------------------------------------------------
+// Env GH2_GPU_PROF=1: GPU timestamps (bottom of pipe) bracket every render pass, copy/resolve and the swap of a frame.
+// Results of finished frames are read back lazily and every 120 frames one line of per-frame averages goes to stderr.
+// Frame time not covered by the three regions is "other" (shared memory / texture uploads, barriers, idle).
+namespace {
+constexpr uint32_t kGpuProfSlices = 3, kGpuProfQueriesPerSlice = 1024;
+}
+
+void VulkanCommandProcessor::GpuProfFrameOpen() {
+  static const bool wanted = getenv("GH2_GPU_PROF") != nullptr;
+  if (!wanted) return;
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  if (gpu_prof_pool_ == VK_NULL_HANDLE) {
+    VkQueryPoolCreateInfo info = {};
+    info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    info.queryCount = kGpuProfSlices * kGpuProfQueriesPerSlice;
+    if (dfn.vkCreateQueryPool(vulkan_device->device(), &info, nullptr, &gpu_prof_pool_) != VK_SUCCESS) return;
+    VkPhysicalDeviceProperties props = {};
+    vulkan_device->vulkan_instance()->functions().vkGetPhysicalDeviceProperties(vulkan_device->physical_device(), &props);
+    gpu_prof_period_ns_ = props.limits.timestampPeriod;
+  }
+  GpuProfPoll();
+  const uint32_t slice = gpu_prof_frame_counter_ % kGpuProfSlices;
+  for (const auto& f : gpu_prof_pending_)
+    if (f.slice == slice) {  // that slice's results have not been read yet: skip profiling this frame
+      gpu_prof_enabled_ = false;
+      return;
+    }
+  gpu_prof_current_ = {};
+  gpu_prof_current_.slice = slice;
+  deferred_command_buffer_.CmdVkResetQueryPool(gpu_prof_pool_, slice * kGpuProfQueriesPerSlice, kGpuProfQueriesPerSlice);
+  gpu_prof_enabled_ = true;
+}
+
+void VulkanCommandProcessor::GpuProfMark(GpuProfLabel label, bool begin) {
+  if (!gpu_prof_enabled_ || !submission_open_ || gpu_prof_current_.marks.size() >= kGpuProfQueriesPerSlice) return;
+  const uint32_t query = gpu_prof_current_.slice * kGpuProfQueriesPerSlice + uint32_t(gpu_prof_current_.marks.size());
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, gpu_prof_pool_, query);
+  gpu_prof_current_.marks.push_back({query, uint8_t(label), begin});
+}
+
+void VulkanCommandProcessor::GpuProfFrameClose() {
+  if (!gpu_prof_enabled_) return;
+  gpu_prof_enabled_ = false;
+  gpu_prof_current_.submission = GetCurrentSubmission();
+  ++gpu_prof_frame_counter_;
+  gpu_prof_pending_.push_back(std::move(gpu_prof_current_));
+  gpu_prof_current_ = {};
+}
+
+void VulkanCommandProcessor::GpuProfPoll() {
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  while (!gpu_prof_pending_.empty() && gpu_prof_pending_.front().submission <= GetCompletedSubmission()) {
+    GpuProfFrame frame = std::move(gpu_prof_pending_.front());
+    gpu_prof_pending_.pop_front();
+    std::vector<uint64_t> ts(frame.marks.size());
+    if (ts.empty() || dfn.vkGetQueryPoolResults(vulkan_device->device(), gpu_prof_pool_,
+                                                frame.slice * kGpuProfQueriesPerSlice, uint32_t(ts.size()),
+                                                ts.size() * sizeof(uint64_t), ts.data(), sizeof(uint64_t),
+                                                VK_QUERY_RESULT_64_BIT) != VK_SUCCESS)
+      continue;
+    uint64_t begin_ts[kGpuProfLabelCount] = {};
+    double ms[kGpuProfLabelCount] = {};
+    uint32_t calls[kGpuProfLabelCount] = {};
+    uint64_t swap_end = 0;
+    for (size_t i = 0; i < frame.marks.size(); ++i) {
+      const auto& m = frame.marks[i];
+      if (m.begin) {
+        begin_ts[m.label] = ts[i];
+      } else if (begin_ts[m.label]) {
+        ms[m.label] += double(ts[i] - begin_ts[m.label]) * gpu_prof_period_ns_ * 1e-6;
+        ++calls[m.label];
+        begin_ts[m.label] = 0;
+        if (m.label == kGpuProfSwap) swap_end = ts[i];
+      }
+    }
+    if (swap_end && gpu_prof_last_swap_end_) {
+      gpu_prof_period_sum_ms_ += double(swap_end - gpu_prof_last_swap_end_) * gpu_prof_period_ns_ * 1e-6;
+      for (uint32_t l = 0; l < kGpuProfLabelCount; ++l) {
+        gpu_prof_sum_ms_[l] += ms[l];
+        gpu_prof_counts_[l] += calls[l];
+      }
+      ++gpu_prof_frames_;
+    }
+    if (swap_end) gpu_prof_last_swap_end_ = swap_end;
+    if (gpu_prof_frames_ >= 120) {
+      const double n = gpu_prof_frames_;
+      const double covered = gpu_prof_sum_ms_[0] + gpu_prof_sum_ms_[1] + gpu_prof_sum_ms_[2];
+      fprintf(stderr,
+              "GPUPROF frames=%u frame=%.2fms | renderpass=%.2fms (%.1f/frame) copy=%.2fms (%.1f/frame) swap=%.2fms | other=%.2fms\n",
+              gpu_prof_frames_, gpu_prof_period_sum_ms_ / n, gpu_prof_sum_ms_[0] / n, gpu_prof_counts_[0] / n,
+              gpu_prof_sum_ms_[1] / n, gpu_prof_counts_[1] / n, gpu_prof_sum_ms_[2] / n,
+              (gpu_prof_period_sum_ms_ - covered) / n);
+      gpu_prof_frames_ = 0;
+      gpu_prof_period_sum_ms_ = 0;
+      for (uint32_t l = 0; l < kGpuProfLabelCount; ++l) gpu_prof_sum_ms_[l] = 0, gpu_prof_counts_[l] = 0;
+    }
+  }
+}
