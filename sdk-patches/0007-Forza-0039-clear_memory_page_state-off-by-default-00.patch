From d0653d6471ac60ddec9af83aff9b395e13153cac Mon Sep 17 00:00:00 2001
From: gh2 <x@x>
Date: Tue, 20 Oct 2026 09:14:17 -0300
Subject: [PATCH 7/7] Forza 0039 (clear_memory_page_state off by default), 0031
 (shared memory: no lock for valid ranges), 0049 (memexport readback check
 order)

---
 include/rex/graphics/shared_memory.h      |  2 +
 src/graphics/command_processor.cpp        | 11 ++++--
 src/graphics/d3d12/command_processor.cpp  |  6 ++-
 src/graphics/shared_memory.cpp            | 47 ++++++++++++++++++++---
 src/graphics/vulkan/command_processor.cpp |  6 ++-
 5 files changed, 59 insertions(+), 13 deletions(-)

diff --git a/include/rex/graphics/shared_memory.h b/include/rex/graphics/shared_memory.h
index 4d85a2b..9212446 100644
--- a/include/rex/graphics/shared_memory.h
+++ b/include/rex/graphics/shared_memory.h
@@ -160,6 +160,8 @@ class SharedMemory {
   // Ranges that need to be uploaded, generated by GetRangesToUpload (a
   // persistently allocated vector).
   std::vector<std::pair<uint32_t, uint32_t>> upload_ranges_;
+  // RequestRanges' merged ranges, kept to reuse the allocation.
+  std::vector<std::pair<uint32_t, uint32_t>> request_ranges_merged_;
 
   // Mutex between the guest memory subsystem and the command processor, to be
   // locked when checking or updating validity of pages/ranges and when firing
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index a744375..6fdf818 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -37,9 +37,14 @@
 
 REXCVAR_DEFINE_BOOL(vsync, true, "GPU", "Enable vertical sync");
 
-REXCVAR_DEFINE_BOOL(clear_memory_page_state, true, "GPU",
-                    "Refresh page-valid state from GPU-written memory at frame end. "
-                    "Disable for minor CPU overhead reduction, but may break memory coherency.")
+// Off as in Xenia, where it is a fix for Team Ninja games (missing character models). On, every
+// page the CPU wrote and the GPU read is uploaded again after every frame, written or not: in a
+// Forza race that is ~500,000 pages (2 GB) a second of copies on the command processor thread.
+// Pages the CPU writes are still caught by the write watches and uploaded again when used.
+REXCVAR_DEFINE_BOOL(clear_memory_page_state, false, "GPU",
+                    "Refresh page-valid state from GPU-written memory at frame end, so that "
+                    "everything the CPU wrote is uploaded again (Xenia uses it for Team Ninja "
+                    "games). Costs a full re-upload of the frame's CPU-written GPU data.")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
 REXCVAR_DEFINE_BOOL(occlusion_query_enable, true, "GPU", "Enable host occlusion query handling")
diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 19874a5..abcad07 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -2711,8 +2711,10 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint3
       // be unknown. Keep invalidation conservative in this case.
       shared_memory_->RangeWrittenByGpu(0, SharedMemory::kBufferSize);
     }
-    if (IsReadbackMemexportEnabled(REXCVAR_GET(d3d12_readback_memexport)) &&
-        !memexport_ranges_.empty()) {
+    // Empty first: the setting check looks the legacy setting up by name (a lock, two
+    // strings and a hash lookup), which was 15% of the command processor in a race.
+    if (!memexport_ranges_.empty() &&
+        IsReadbackMemexportEnabled(REXCVAR_GET(d3d12_readback_memexport))) {
       uint32_t memexport_total_size = 0;
       for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
         memexport_total_size += memexport_range.size_bytes;
diff --git a/src/graphics/shared_memory.cpp b/src/graphics/shared_memory.cpp
index ec0df7c..6be0eb0 100644
--- a/src/graphics/shared_memory.cpp
+++ b/src/graphics/shared_memory.cpp
@@ -343,8 +343,8 @@ bool SharedMemory::RequestRanges(const std::pair<uint32_t, uint32_t>* ranges, si
   }
 
   // Some texture or buffer is empty, for example - safe to draw in this case.
-  std::vector<std::pair<uint32_t, uint32_t>> merged_ranges;
-  merged_ranges.reserve(count);
+  std::vector<std::pair<uint32_t, uint32_t>>& merged_ranges = request_ranges_merged_;
+  merged_ranges.clear();
   for (size_t i = 0; i < count; ++i) {
     uint32_t start = ranges[i].first;
     uint32_t length = ranges[i].second;
@@ -362,10 +362,12 @@ bool SharedMemory::RequestRanges(const std::pair<uint32_t, uint32_t>* ranges, si
 
   SCOPE_profile_cpu_f("gpu");
 
-  std::sort(merged_ranges.begin(), merged_ranges.end(),
-            [](const std::pair<uint32_t, uint32_t>& a, const std::pair<uint32_t, uint32_t>& b) {
-              return a.first < b.first;
-            });
+  if (merged_ranges.size() > 1) {
+    std::sort(merged_ranges.begin(), merged_ranges.end(),
+              [](const std::pair<uint32_t, uint32_t>& a, const std::pair<uint32_t, uint32_t>& b) {
+                return a.first < b.first;
+              });
+  }
   size_t merged_write = 0;
   for (size_t i = 1; i < merged_ranges.size(); ++i) {
     std::pair<uint32_t, uint32_t>& range_previous = merged_ranges[merged_write];
@@ -389,6 +391,39 @@ bool SharedMemory::RequestRanges(const std::pair<uint32_t, uint32_t>* ranges, si
     }
   }
 
+  // Nothing to upload if every page is valid already, the common case for data
+  // drawn from again. Check that without the global critical region, which the
+  // guest threads contend for: a page the guest has written to is marked invalid
+  // before its write completes, and the guest submits the commands using the
+  // data after writing it, so the check here sees that.
+  bool all_valid = true;
+  for (const std::pair<uint32_t, uint32_t>& range : merged_ranges) {
+    uint32_t page_first = range.first >> page_size_log2_;
+    uint32_t page_last = (range.first + range.second - 1) >> page_size_log2_;
+    uint32_t block_first = page_first >> 6;
+    uint32_t block_last = page_last >> 6;
+    for (uint32_t i = block_first; i <= block_last; ++i) {
+      uint64_t valid_mask = UINT64_MAX;
+      if (i == block_first) {
+        valid_mask &= ~((uint64_t(1) << (page_first & 63)) - 1);
+      }
+      if (i == block_last && (page_last & 63) != 63) {
+        valid_mask &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+      }
+      uint64_t block_valid = __atomic_load_n(&system_page_flags_valid_[i], __ATOMIC_ACQUIRE);
+      if ((block_valid & valid_mask) != valid_mask) {
+        all_valid = false;
+        break;
+      }
+    }
+    if (!all_valid) {
+      break;
+    }
+  }
+  if (all_valid) {
+    return true;
+  }
+
   upload_ranges_.clear();
   auto append_upload_range = [this](uint32_t page_start, uint32_t page_count) {
     if (!page_count) {
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
