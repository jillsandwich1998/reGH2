# Patches and shell scripts must stay LF on every platform: Windows checkouts (autocrlf=true) would otherwise turn them into CRLF,
# and a CRLF patch does not apply to the LF sources of the SDK; a CRLF shell script does not run.
*.patch text eol=lf
*.sh text eol=lf
AppRun text eol=lf
*.in text eol=lf
