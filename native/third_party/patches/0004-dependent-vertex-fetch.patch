+#ifdef __spirv__
+// GH2: a vertex fetch whose index register the shader computed itself (multi-mesh draws: the vertex index selects an entry of one stream, that entry the vertex of another) cannot be
+// served by the input assembler. The renderer uploads the whole stream and describes it at SharedConstants + 320 + 16 * element (the element's position in the container's vertex
+// element table): u32 address low, u32 address high, u32 stride in bytes, u32 meta = Xenos vertex format | signed << 8 | integer << 9 | byte offset << 10. The bytes are already
+// endian swapped; the formats decode the way Vulkan would read the same bytes as vertex attributes.
+struct DependentFetch
+{
+    uint64_t address;
+    uint stride;
+    uint format;
+    bool isSigned;
+    bool isInteger;
+    uint offset;
+};
+
+DependentFetch getDependentFetch(uint element)
+{
+    uint64_t at = g_PushConstants.SharedConstants + 320 + element * 16;
+    DependentFetch f;
+    f.address = uint64_t(vk::RawBufferLoad<uint>(at)) | (uint64_t(vk::RawBufferLoad<uint>(at + 4)) << 32);
+    f.stride = vk::RawBufferLoad<uint>(at + 8);
+    uint meta = vk::RawBufferLoad<uint>(at + 12);
+    f.format = meta & 0xFF;
+    f.isSigned = ((meta >> 8) & 1) != 0;
+    f.isInteger = ((meta >> 9) & 1) != 0;
+    f.offset = meta >> 10;
+    return f;
+}
+
+uint dependentWord(DependentFetch f, uint index, uint word)
+{
+    return vk::RawBufferLoad<uint>(f.address + uint64_t(index) * f.stride + f.offset + word * 4);
+}
+
+float2 unpackHalf2(uint w)
+{
+    return float2(f16tof32(w & 0xFFFF), f16tof32(w >> 16));
+}
+
+float unpack16(uint v, bool isSigned, bool isInteger)
+{
+    float x = isSigned ? float(int(v << 16) >> 16) : float(v);
+    return isInteger ? x : (isSigned ? max(x / 32767.0, -1.0) : x / 65535.0);
+}
+
+float unpack8(uint v, bool isSigned, bool isInteger)
+{
+    float x = isSigned ? float(int(v << 24) >> 24) : float(v);
+    return isInteger ? x : (isSigned ? max(x / 127.0, -1.0) : x / 255.0);
+}
+
+float4 vertexFetchDependent(uint element, uint index)
+{
+    DependentFetch f = getDependentFetch(element);
+    float4 r = float4(0.0, 0.0, 0.0, 1.0);
+    switch (f.format)
+    {
+    case 36:
+        r.x = asfloat(dependentWord(f, index, 0));
+        break;
+    case 37:
+        r.xy = asfloat(uint2(dependentWord(f, index, 0), dependentWord(f, index, 1)));
+        break;
+    case 57:
+        r.xyz = asfloat(uint3(dependentWord(f, index, 0), dependentWord(f, index, 1), dependentWord(f, index, 2)));
+        break;
+    case 38:
+        r = asfloat(uint4(dependentWord(f, index, 0), dependentWord(f, index, 1), dependentWord(f, index, 2), dependentWord(f, index, 3)));
+        break;
+    case 33:
+        r.x = f.isSigned ? float(int(dependentWord(f, index, 0))) : float(dependentWord(f, index, 0));
+        break;
+    case 34:
+        r.x = f.isSigned ? float(int(dependentWord(f, index, 0))) : float(dependentWord(f, index, 0));
+        r.y = f.isSigned ? float(int(dependentWord(f, index, 1))) : float(dependentWord(f, index, 1));
+        break;
+    case 35:
+        for (uint i = 0; i < 4; i++)
+        {
+            uint w = dependentWord(f, index, i);
+            r[i] = f.isSigned ? float(int(w)) : float(w);
+        }
+        break;
+    case 31:
+        r.xy = unpackHalf2(dependentWord(f, index, 0));
+        break;
+    case 32:
+        r = float4(unpackHalf2(dependentWord(f, index, 0)), unpackHalf2(dependentWord(f, index, 1)));
+        break;
+    case 25:
+    {
+        uint w = dependentWord(f, index, 0);
+        r.xy = float2(unpack16(w & 0xFFFF, f.isSigned, f.isInteger), unpack16(w >> 16, f.isSigned, f.isInteger));
+        break;
+    }
+    case 26:
+    {
+        uint w0 = dependentWord(f, index, 0), w1 = dependentWord(f, index, 1);
+        r = float4(unpack16(w0 & 0xFFFF, f.isSigned, f.isInteger), unpack16(w0 >> 16, f.isSigned, f.isInteger), unpack16(w1 & 0xFFFF, f.isSigned, f.isInteger), unpack16(w1 >> 16, f.isSigned, f.isInteger));
+        break;
+    }
+    case 6:
+    {
+        uint w = dependentWord(f, index, 0);
+        r = float4(unpack8(w & 0xFF, f.isSigned, f.isInteger), unpack8((w >> 8) & 0xFF, f.isSigned, f.isInteger), unpack8((w >> 16) & 0xFF, f.isSigned, f.isInteger), unpack8(w >> 24, f.isSigned, f.isInteger));
+        break;
+    }
+    case 7:
+    {
+        uint w = dependentWord(f, index, 0);
+        float3 c = float3(w & 0x3FF, (w >> 10) & 0x3FF, (w >> 20) & 0x3FF);
+        float a = float(w >> 30);
+        if (f.isSigned)
+            r = float4(max(float3(int3(int3(c) << 22) >> 22) / 511.0, -1.0), max(float(int(w >> 30 << 30) >> 30), -1.0));
+        else
+            r = float4(c / 1023.0, a / 3.0);
+        break;
+    }
+    default:
+        break;
+    }
+    return r;
+}
+
+// the same fetch for the inputs the translated shader reads as raw words (normals, tangents, binormals)
+uint4 vertexFetchDependentU(uint element, uint index)
+{
+    DependentFetch f = getDependentFetch(element);
+    uint4 r = uint4(0, 0, 0, 1);
+    uint words = 1;
+    if (f.format == 26 || f.format == 32 || f.format == 34 || f.format == 37)
+        words = 2;
+    else if (f.format == 57)
+        words = 3;
+    else if (f.format == 35 || f.format == 38)
+        words = 4;
+    for (uint i = 0; i < words; i++)
+        r[i] = dependentWord(f, index, i);
+    return r;
+}
