+// GH2: has a statement before this point written this component of the register? (a vertex fetch indexed by such a register reads a stream the shader itself indexes)
+bool ShaderRecompiler::registerWritten(uint32_t reg, char component) const
+{
+    const std::string needle = fmt::format("r{}.", reg);
+    for (size_t at = out.find(needle); at != std::string::npos; at = out.find(needle, at + 1))
+    {
+        size_t line = at;
+        while (line > 0 && (out[line - 1] == '\t' || out[line - 1] == ' '))
+            --line;
+        if (line != 0 && out[line - 1] != '\n')
+            continue;   // not the start of a statement: a read
+        size_t c = at + needle.size();
+        bool hasComponent = false;
+        while (c < out.size() && (out[c] == 'x' || out[c] == 'y' || out[c] == 'z' || out[c] == 'w'))
+        {
+            hasComponent = hasComponent || out[c] == component;
+            ++c;
+        }
+        if (hasComponent && out.compare(c, 3, " = ") == 0)
+            return true;
+    }
+    return false;
+}
