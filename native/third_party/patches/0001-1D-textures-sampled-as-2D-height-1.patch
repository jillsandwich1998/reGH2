     return r;
 }
 
+// GH2: a 1D fetch reads a texture that the host binds as a 2D texture one texel high (the recompiler makes <name>_Texture1DDescriptorIndex
+// an alias of <name>_Texture2DDescriptorIndex), sampled at the middle of its only row. This keeps the shared-constants layout unchanged.
+float4 tfetch1D(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float texCoord)
+{
+    return g_Texture2DDescriptorHeap[resourceDescriptorIndex].Sample(g_SamplerDescriptorHeap[samplerDescriptorIndex], float2(texCoord, 0.5));
+}
+
 float4 tfetch3D(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float3 texCoord)
 {
     return g_Texture3DDescriptorHeap[resourceDescriptorIndex].Sample(g_SamplerDescriptorHeap[samplerDescriptorIndex], texCoord);
